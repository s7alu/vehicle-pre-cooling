# Vercel OIDC token — auto-generated by `vercel link` / `vercel env pull`, never set by hand.
VERCEL_OIDC_TOKEN=

# Sentry error tracking — created by the Sentry Vercel integration, scoped to Preview + Production.
# Run `vercel env pull --environment=production` to check which vars exist; values are "Secret"
# type in Vercel and cannot be read back via the CLI, so get them from the Sentry dashboard if you
# need a local value. Without a DSN, the SDK no-ops and nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
